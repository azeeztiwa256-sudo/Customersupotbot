# ── Telegram ──────────────────────────────────
BOT_TOKEN=123456789:ABCdefGhIJKlmnOPQrSTuVWxYz
ADMIN_IDS=111111111,222222222

# ── DeepSeek AI ───────────────────────────────
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
AI_ENABLED=true

# ── Database ──────────────────────────────────
# Local: sqlite+aiosqlite:///./bot.db
# Railway: leave as SQLite, or add a Postgres plugin and use its DATABASE_URL
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# ── Business defaults ─────────────────────────
BUSINESS_NAME=Acme Support
BUSINESS_DESCRIPTION=We provide 24/7 customer assistance.
WELCOME_EXTRA=How can I assist you today?
SUPPORT_CONTACT=@AcmeSupport
BUSINESS_HOURS=Mon-Fri, 9:00-18:00 UTC
WEBSITE=https://example.com

# ── Web dashboard (optional) ──────────────────
WEB_DASHBOARD_ENABLED=false
WEB_DASHBOARD_HOST=0.0.0.0
WEB_DASHBOARD_PORT=8080
WEB_DASHBOARD_PASSWORD=change-me

# ── Safety ────────────────────────────────────
RATE_LIMIT_SECONDS=2
AI_TIMEOUT_SECONDS=30
